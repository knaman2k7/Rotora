# --- Backend (server/) ---

# Render/Neon: full connection string. When set, this is used instead of the
# DB_* variables below, and SSL is enabled automatically.
DATABASE_URL=

# Local dev fallback (used only when DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Rotora

JWTsecret=

# Port the backend listens on (Render sets this automatically)
PORT=3000

# Used to restrict CORS. Only needed for local dev (running `vite` and the
# server as two separate origins) - in production the server serves the
# frontend itself, so requests are same-origin and this isn't consulted.
FRONTEND_URL=http://localhost:5173

# --- Frontend (src/, Vite) ---

# Base URL of the backend API. Leave unset - requests default to a relative
# URL, which works both in production (single Express server serves both)
# and in local dev (vite.config.js proxies /api to the backend below).
VITE_API_URL=
