# --- Backend (server/) ---

# Render/Neon: full connection string. When set, this is used instead of the
# DB_* variables below, and SSL is enabled automatically.
DATABASE_URL=

# Local dev fallback (used only when DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Rotora

JWTsecret=

# Port the backend listens on (Render sets this automatically)
PORT=3000

# URL of the deployed frontend, used to restrict CORS
FRONTEND_URL=http://localhost:5173

# --- Frontend (src/, Vite) ---

# Base URL of the backend API. Leave unset for local dev to use the default
# (http://localhost:3000).
VITE_API_URL=http://localhost:3000
